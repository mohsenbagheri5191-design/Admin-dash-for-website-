# ═══════════════════════════════════════════════════════════════
#  Environment variables — set these in Netlify:
#  Site configuration → Environment variables
# ═══════════════════════════════════════════════════════════════
#
#  ONLY these two exist for this repo, and both are safe in a browser.
#  The anon (publishable) key identifies the project; it does not grant
#  access. Every table is behind Row Level Security and every Edge Function
#  re-reads the caller's profile from the database before doing any work.

SUPABASE_URL=https://ftwkxuqqnbtuegabxxnj.supabase.co

# Either key type works. The legacy anon JWT is the widest-compatibility
# choice; the sb_publishable_ key is what Supabase recommends for new apps.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_ANON_KEY=sb_publishable_...

# ───────────────────────────────────────────────────────────────
#  NEVER PUT THESE HERE
# ───────────────────────────────────────────────────────────────
#  SUPABASE_SERVICE_ROLE_KEY  — bypasses every RLS policy. It belongs only in
#                               Supabase → Edge Functions → Secrets, where the
#                               functions already read it. If it ever appears
#                               in this repo, in a Netlify build variable, or
#                               in any file this site serves, rotate it.
#
#  tools/build-config.mjs refuses to build if SUPABASE_ANON_KEY looks like a
#  service-role or sb_secret_ key.
